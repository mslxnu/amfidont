<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beako.amfidont</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/amfidont</string>
        <string>--verbose</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/amfidont.out</string>
    <key>StandardErrorPath</key>
    <string>/var/log/amfidont.err</string>
</dict>
</plist>
